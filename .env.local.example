# ===== Скопируй этот файл в .env.local и подставь свои значения =====

# --- Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID) ---
GOOGLE_CLIENT_ID=твой_google_client_id
GOOGLE_CLIENT_SECRET=твой_google_client_secret

# --- NextAuth ---
# секрет генерится командой: openssl rand -base64 32
NEXTAUTH_SECRET=случайная_длинная_строка
# локально это http://localhost:3000, на проде - твой адрес vercel
NEXTAUTH_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# service_role key - СЕКРЕТНЫЙ, только на сервере, в браузер не попадает
SUPABASE_SERVICE_ROLE_KEY=service_role_key

# --- Админка (логин/пароль admin/admin зашиты на клиенте; это токен для API) ---
ADMIN_TOKEN=admin

# --- Telegram bot (получить у @BotFather) ---
TELEGRAM_BOT_TOKEN=токен_бота
